Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Axes: true
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Axis: Z
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Lidar Points
      Topic:
        Value: /scan/points
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: RGBD Points
      Topic:
        Value: /camera/points
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.01
      Style: Flat Squares
      Color Transformer: RGB8
      Axis: Z
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO Cloud
      Topic:
        Value: /cloud_registered
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO Map
      Topic:
        Value: /Laser_map
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: FAST-LIO Path
      Topic:
        Value: /path
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Image
      Topic:
        Value: /camera/image
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Depth Image
      Topic:
        Value: /camera/depth_image
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 10
      Median window: 5
      Min Value: 0
      Normalize Range: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
      Name: Current View
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  Image:
    collapsed: false
  Depth Image:
    collapsed: false
