<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="spot_obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
                <min_depth>0.001</min_depth>
                <max_vel>0.5</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boxes (static obstacles) -->
    <model name="box_red">
      <static>true</static>
      <!-- Side of spawn (+Y); clear of forward path along +X -->
      <pose>2.5 4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_blue">
      <static>true</static>
      <pose>5 2 0.35 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material>
            <ambient>0.2 0.3 0.8 1</ambient>
            <diffuse>0.2 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_green">
      <static>true</static>
      <pose>-3 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.2 0.7 0.3 1</ambient>
            <diffuse>0.2 0.7 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cylinders -->
    <model name="cylinder_orange">
      <static>true</static>
      <pose>2 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.5 0.1 1</ambient>
            <diffuse>0.9 0.5 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cylinder_purple">
      <static>true</static>
      <pose>-2 -2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.2 0.7 1</ambient>
            <diffuse>0.6 0.2 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sphere -->
    <model name="sphere_yellow">
      <static>true</static>
      <pose>4 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.85 0.2 1</ambient>
            <diffuse>0.9 0.85 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low wall / barrier -->
    <model name="wall_front">
      <static>true</static>
      <pose>6 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 4 0.8</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_side">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.3 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.3 1.0</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.5 1</ambient>
            <diffuse>0.45 0.45 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall pillar -->
    <model name="pillar">
      <static>true</static>
      <pose>-4 -1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 2.0</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.4 1</ambient>
            <diffuse>0.35 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Boundary walls =====================
         Fully closed 16 x 14 m arena (interior x in [-8, 8], y in [-7, 7]),
         which encloses every obstacle above (they span x -4.25..6.15,
         y -3.4..5.15) with at least 1.8 m of clearance, and keeps the robot
         spawn at the origin well clear of the walls.
         Wall centerlines sit on the interior bounds; the N/S walls run the
         full width so the four corners overlap and leave no gaps for the
         LiDAR to see through. Height 1.5 m keeps them inside the LiDAR's
         +/-15 deg vertical field of view at close range. -->
    <model name="boundary_wall_north">
      <static>true</static>
      <pose>0 7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.2 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_south">
      <static>true</static>
      <pose>0 -7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.2 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_east">
      <static>true</static>
      <pose>8 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 13.8 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 13.8 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.53 1</ambient>
            <diffuse>0.5 0.5 0.53 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_west">
      <static>true</static>
      <pose>-8 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 13.8 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 13.8 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.53 1</ambient>
            <diffuse>0.5 0.5 0.53 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
