        <mesh filename="package://robot_dog_laser_designator/meshes/rl_hip_yaw_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="rl_hip_yaw_connector_joint" type="fixed">
    <parent link="rl_hip_yaw"/>
    <child link="rl_hip_yaw_connector"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rl_knee">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0.234712 -0.218986 0.311924" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rl_knee.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="midnight_black"/>
    </visual>
    <collision name="rl_knee_collision">
      <origin xyz="0.234712 -0.218986 0.311924" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rl_knee.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <!-- Foot pad center, fitted from rl_knee.STL; see fl_foot_contact_sphere note above. -->
    <collision name="rl_foot_contact_sphere">
      <origin xyz="0.000710 -0.022170 -0.370600" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0415"/>
      </geometry>
    </collision>
  </link>
  <joint name="rl_knee_joint" type="revolute">
    <parent link="rl_hip_yaw_connector"/>
    <child link="rl_knee"/>
    <origin xyz="0.039612 0.063535 -0.398541" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.631" upper="-0.662" effort="100" velocity="10"/>
  </joint>
  <!-- ===================== rr leg ===================== -->
  <link name="rr_hip_roll">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0.224324 0.014549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_roll.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="midnight_black"/>
    </visual>
    <collision>
      <origin xyz="0.224324 0.014549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_roll.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_hip_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rr_hip_roll"/>
    <origin xyz="-0.224324 -0.014549 0.086617" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.239" upper="0.500" effort="100" velocity="10"/>
  </joint>
  <link name="rr_hip_roll_connector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="5e-05" ixy="0" ixz="0" iyy="5e-05" iyz="0" izz="5e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.224324 0.014549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_roll_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.224324 0.014549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_roll_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_hip_roll_connector_joint" type="fixed">
    <parent link="rr_hip_roll"/>
    <child link="rr_hip_roll_connector"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rr_hip_yaw">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0.274324 0.084549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_yaw.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="spot_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.274324 0.084549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_yaw.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_hip_yaw_joint" type="revolute">
    <parent link="rr_hip_roll_connector"/>
    <child link="rr_hip_yaw"/>
    <origin xyz="-0.050000 -0.070000 0.000000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10"/>
  </joint>
  <link name="rr_hip_yaw_connector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="5e-05" ixy="0" ixz="0" iyy="5e-05" iyz="0" izz="5e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.274324 0.084549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_yaw_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.274324 0.084549 -0.086617" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_hip_yaw_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_hip_yaw_connector_joint" type="fixed">
    <parent link="rr_hip_yaw"/>
    <child link="rr_hip_yaw_connector"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rr_knee">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0.234712 0.148084 0.311924" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_knee.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="midnight_black"/>
    </visual>
    <collision name="rr_knee_collision">
      <origin xyz="0.234712 0.148084 0.311924" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_dog_laser_designator/meshes/rr_knee.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <!-- Foot pad center, fitted from rr_knee.STL; see fl_foot_contact_sphere note above. -->
    <collision name="rr_foot_contact_sphere">
      <origin xyz="0.000780 0.021790 -0.370380" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0415"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_knee_joint" type="revolute">
    <parent link="rr_hip_yaw_connector"/>
    <child link="rr_knee"/>
    <origin xyz="0.039612 -0.063535 -0.398541" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.631" upper="-0.662" effort="100" velocity="10"/>
  </joint>

  <!-- ===================== Foot contact friction ===================== -->
  <gazebo reference="fl_knee">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>5e5</kp>
    <kd>800</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <sensor name="fl_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/foot_contact/fl</topic>
      <!-- Collision name must match the post-URDF->SDF conversion name
           (urdf2sdf renames/lumps them), not the name used in <link> above:
           a <collision> here that doesn't resolve makes the sensor silently
           publish nothing. Only the foot sphere is watched; the shin mesh
           also grazes the ground, which would report swing legs as stance and
           cancel out the stance legs in leg_odometry_node's velocity average. -->
      <contact>
        <collision>fl_knee_fixed_joint_lump__fl_foot_contact_sphere_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="fr_knee">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>5e5</kp>
    <kd>800</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <sensor name="fr_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/foot_contact/fr</topic>
      <contact>
        <collision>fr_knee_fixed_joint_lump__fr_foot_contact_sphere_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="rl_knee">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>5e5</kp>
    <kd>800</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <sensor name="rl_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/foot_contact/rl</topic>
      <contact>
        <collision>rl_knee_fixed_joint_lump__rl_foot_contact_sphere_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="rr_knee">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>5e5</kp>
    <kd>800</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <sensor name="rr_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/foot_contact/rr</topic>
      <contact>
        <collision>rr_knee_fixed_joint_lump__rr_foot_contact_sphere_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo sensors ===================== -->
  <gazebo reference="lidar">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <visualize>true</visualize>
      <gz_frame_id>lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_sensor">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_sensor</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera</topic>
      <visualize>true</visualize>
      <!-- gz-sensors emits the RGBD point cloud XYZ in the sensor link frame
           (X forward) but stamps every camera message with a single frame id
           (gz-sensors#488). Naming the optical frame here therefore made RViz
           re-rotate the cloud 90 deg onto the robot's right; the link frame
           keeps /camera/points geometrically correct. The cost is that
           image/camera_info are not tagged with an optical-convention frame,
           so RViz's Camera display cannot project them. -->
      <gz_frame_id>camera</gz_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== ros2_control (12 DoF) ===================== -->
  <!-- initial_value = stand pose (hip 0.764, knee -1.646); zero pose is outside knee limits -->
  <ros2_control name="SpotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="fl_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fl_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.764</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fl_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.646</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fr_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fr_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.764</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fr_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.646</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rl_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rl_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.764</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rl_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.646</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rr_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rr_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.764</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rr_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.646</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>SPOT_CONTROLLERS_YAML</parameters>
      <!-- Softer position tracking reduces bounce from setpoint changes -->
      <position_proportional_gain>0.08</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
